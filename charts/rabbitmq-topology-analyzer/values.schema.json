{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RabbitMQ Topology Analyzer chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "auth",
    "analysis",
    "captures",
    "storage",
    "resources",
    "service",
    "ingress"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tag": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$",
            "minLength": 1
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "publicOrigin",
        "existingSecret",
        "basic",
        "oidc"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "basic",
            "oidc"
          ]
        },
        "publicOrigin": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
        },
        "basic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usersKey",
            "realm",
            "verificationLimit"
          ],
          "properties": {
            "usersKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "realm": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "verificationLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "discoveryUrl",
            "clientId",
            "clientSecretKey",
            "roleClaim",
            "roleMappingKey",
            "scopes",
            "acceptedAlgorithms"
          ],
          "properties": {
            "issuer": {
              "type": "string"
            },
            "discoveryUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecretKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "roleClaim": {
              "type": "string"
            },
            "roleMappingKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "scopes": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "acceptedAlgorithms": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "basic",
                  "oidc"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "publicOrigin": {
                "type": "string",
                "pattern": "^https://[^/?#@\\s]+$"
              },
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "oidc"
              }
            }
          },
          "then": {
            "properties": {
              "oidc": {
                "properties": {
                  "issuer": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "clientId": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "roleClaim": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "discoveryUrl": {
                    "anyOf": [
                      {
                        "const": ""
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^\\s]+$"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "queueCapacity",
        "heartbeatTtlSeconds",
        "resultTtlSeconds"
      ],
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "queueCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "heartbeatTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resultTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        }
      }
    },
    "captures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUploadBytes",
        "sessionLimit",
        "globalLimit",
        "topologyTtlSeconds",
        "existingClaim"
      ],
      "properties": {
        "maxUploadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "globalLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "topologyTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "existingClaim": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultsMaxBytes",
        "resultsVolumeBytes",
        "temporaryVolumeBytes",
        "ephemeralRequestBytes",
        "ephemeralLimitBytes"
      ],
      "properties": {
        "resultsMaxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resultsVolumeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "temporaryVolumeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ephemeralRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ephemeralLimitBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "annotations",
        "tlsSecretName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tlsSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              }
            }
          }
        }
      ]
    }
  }
}
